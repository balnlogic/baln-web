{
  "routes": [
    { "src": "/surfing/?", "dest": "/surfing/surf.html" },
    { "src": "/surfing/(.*)", "dest": "/surfing/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    {
      "src": "/(.*)",
      "status": 307,
      "headers": { "Location": "https://app.baln.app/app/today" }
    }
  ]
}
